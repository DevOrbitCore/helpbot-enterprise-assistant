# HelpBot Service Configuration (Development Template)
# Copy this file to .env and adjust values for your local machine.
# Never commit your .env file or real API keys to version control.

HELPBOT_ENV=development
HELPBOT_HOST=127.0.0.1
HELPBOT_PORT=8200
HELPBOT_PUBLIC_BASE_URL=http://127.0.0.1:8200

# Comma-separated allowlist of host origins permitted to call HelpBot APIs
HELPBOT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SQLite database URL (relative paths resolve inside helpbot-service/data/)
HELPBOT_DATABASE_URL=sqlite:///./data/helpbot.db
HELPBOT_DATA_DIR=./data

# Upload safety limits
HELPBOT_MAX_UPLOAD_MB=10

# Local development rate limiting (requests per 60 seconds per client key)
HELPBOT_CHAT_RATE_LIMIT_PER_MIN=30
HELPBOT_UPLOAD_RATE_LIMIT_PER_MIN=15

# AI Provider settings
# Provider options: "gemini" (default) or "mock" (offline deterministic testing)
HELPBOT_AI_PROVIDER=gemini
HELPBOT_GEMINI_API_KEY=your_gemini_api_key_here
HELPBOT_GEMINI_MODEL=gemini-2.5-flash

# Development-only identity adapter toggle
# Must be replaced with verified server-side auth in production
HELPBOT_ALLOW_DEV_IDENTITY=true

# Widget branding defaults
HELPBOT_WIDGET_TITLE=HelpBot Support Assistant
HELPBOT_WIDGET_ACCENT_COLOR=#1d4ed8
